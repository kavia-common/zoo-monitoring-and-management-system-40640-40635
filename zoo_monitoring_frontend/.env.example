# Frontend environment configuration for VizAI (React CRA)

# API base URL for backend REST endpoints. Use "mock" to enable mock API mode.
# Takes precedence over REACT_APP_BACKEND_URL.
REACT_APP_API_BASE=mock

# Optional fallback backend URL if API base not set.
REACT_APP_BACKEND_URL=http://localhost:4000

# Frontend/site and WebSocket URLs (optional)
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:4000

# Environment and build knobs
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=true
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false

# Logging level: error | warn | info | debug
REACT_APP_LOG_LEVEL=info

# Healthcheck path used by the app
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags as JSON string. Set {"mockApi": true} to force mock mode.
REACT_APP_FEATURE_FLAGS={"mockApi":true}

# Experiments toggle
REACT_APP_EXPERIMENTS_ENABLED=false
